# ============================================================
#  pharmkg 环境变量模板
#
#  用法（PowerShell）：
#      Copy-Item .env.example .env
#      然后把下面所有 changeme 换成真实密码
#
#  ⚠️ .env 已被 .gitignore 排除，永远不会提交。
#     本文件（.env.example）会提交到公开仓库，所以只能放占位符，
#     绝不能把真实密码写在这里。
# ============================================================


# ── Neo4j ───────────────────────────────────────────────────
NEO4J_PASSWORD=changeme


# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=pharmkg
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pharmkg


# ── 容器数据落地目录 ─────────────────────────────────────────
# 留空       → 使用项目内 ./.docker-data
# 想放 D 盘  → 写 D:/grad-data（避免 Neo4j + PostgreSQL 约 1–2GB 占用 C 盘）
DATA_DIR=


# ── 大模型服务：阿里云百炼 ────────────────────────────────────
# 基线决策 #22：单一 provider，不再保留 DeepSeek 分支。
# 多模型对比靠改 LLM_MODEL 实现，不需要换 provider。

# Key 取自：百炼控制台 → API-KEY 管理
DASHSCOPE_API_KEY=

# OpenAI 兼容地址。下面这行是**已实测打通**的老域名，不需要业务空间 ID：
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 官方推荐改用「业务空间专属域名」（性能与稳定性更好），格式为：
#     https://<你的业务空间ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 业务空间 ID 在百炼控制台 →「业务空间详情」页面查看。
# 注意 {WorkspaceId} 是**占位符**，原样填进去连不通，必须替换成真实 ID。
#
# ⚠️ API Key 与地域绑定：北京地域的 Key 只能配北京地域的地址，
#    跨地域调用会返回 401 invalid_api_key。
# ⚠️ 只有华北2（北京）地域有免费额度，别用新加坡节点。

# 模型名。默认 qwen-plus —— 它可以使用**文本接口**。
# ⚠️ qwen3.8-max / qwen3.8-flash / Qwen3.5、3.6 系列需要走**多模态接口**，
#    直接改这里会报 url error。换模型前先查百炼文档。
LLM_MODEL=qwen-plus
