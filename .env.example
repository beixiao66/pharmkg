# ============================================================
#  pharmkg 环境变量模板
#
#  用法（PowerShell）：
#      Copy-Item .env.example .env
#      然后把下面所有 changeme 换成真实密码
#
#  ⚠️ .env 已被 .gitignore 排除，永远不会提交。
#     本文件（.env.example）会提交到公开仓库，所以只能放占位符，
#     绝不能把真实密码写在这里。
# ============================================================


# ── Neo4j ───────────────────────────────────────────────────
NEO4J_PASSWORD=changeme


# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=pharmkg
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pharmkg


# ── 容器数据落地目录 ─────────────────────────────────────────
# 留空       → 使用项目内 ./.docker-data
# 想放 D 盘  → 写 D:/grad-data（避免 Neo4j + PostgreSQL 约 1–2GB 占用 C 盘）
DATA_DIR=


# ── 大模型服务 ───────────────────────────────────────────────
# LLM_PROVIDER 取值：deepseek | dashscope
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
