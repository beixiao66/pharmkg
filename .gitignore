# ============================================================
#  pharmkg · 毕业设计仓库排除规则
#
#  原则：凡是「体积大 / 可重新下载 / 含密钥 / 有再分发限制」的东西都不入库。
#  数据目录约定（本文件据此排除）：
#      data/raw/        下载来的原始数据集 —— 不入库
#      data/collected/  自己采集的说明书文本 —— 入库（你的研究材料，体积小）
#      data/processed/  加工产物：药名映射表、抽取结果 —— 入库（这是研究成果）
# ============================================================


# ------------------------------------------------------------
# 1. 原始数据集（体积大、可重新下载、部分有再分发限制）★ 重点
# ------------------------------------------------------------
data/raw/
data/downloads/

# 已知的原始数据文件（无论放在哪一层都排除）
triples.txt
entities_dict.txt
manual_annotation.csv
ddinter_downloads_code_*.csv

# 图谱与数据库导出
*.dump
*.graphml

# 说明：DDInter 采用 CC BY-NC-SA 4.0，公开仓库再分发需遵守同协议；
#      OpenCMKG 注明「仅学术研究」。两者都只保留下载脚本与来源说明，
#      数据本体不提交 —— 靠脚本 + 来源 URL 重建，而不是靠仓库里的大文件。


# ------------------------------------------------------------
# 2. 密钥与环境变量（绝对不入库）
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets/
config.local.*


# ------------------------------------------------------------
# 3. Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/
ENV/
.python-version

# 工具缓存与覆盖率
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/


# ------------------------------------------------------------
# 4. 前端（Vue3 + Vite）
# ------------------------------------------------------------
node_modules/
.vite/
frontend/dist/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# 注意：package-lock.json / pnpm-lock.yaml 要提交，别加进来


# ------------------------------------------------------------
# 5. 数据库与运行时产物
# ------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
neo4j/data/
neo4j/logs/
neo4j/import/
volumes/
logs/
*.log


# ------------------------------------------------------------
# 6. IDE / 编辑器
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~


# ------------------------------------------------------------
# 7. 操作系统
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini


# ------------------------------------------------------------
# 8. Office 临时锁文件（Word 打开 .docx 时会生成 ~$ 开头的文件）
# ------------------------------------------------------------
~$*


# ------------------------------------------------------------
# 9. Office 文档（Word / Excel / PowerPoint）—— 全部排除
#    理由一：二进制文件，git 无法做行级差异。用 Office 改一个字保存，
#            git 就会把整个文件重存一份完整副本，仓库迅速膨胀，
#            而且历史里根本看不出改了什么。
#    理由二：这类文档通常含个人信息（姓名 / 学号）。
#    开题报告、中期检查表、毕业论文、答辩材料等都属此类，
#    统一交给本地备份管理。
#
#    用通配符而非文件名，所以后续新写的文档会自动被排除，无需再改规则。
#    例外：需要版本管理的数据表请导出成 .csv 再入库 —— 纯文本，
#          git 能逐行比较，这才是版本控制该管的东西。
# ------------------------------------------------------------
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt
